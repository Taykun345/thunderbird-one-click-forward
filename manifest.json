{
  "manifest_version": 2,
  "name": "Bulk Inline Forward",
  "version": "1.0",
  "author": "CJS (based on One-Click Forward by David Trapp)",
  "description": "Forward multiple selected emails inline to predefined recipients with one click",
  "permissions": [
    "accountsRead",
    "messagesRead",
    "messagesMove",
    "messagesDelete",
    "compose",
    "compose.send",
    "storage",
    "notifications",
    "mailTabs",
    "menus"
  ],
  "background": {
    "scripts": ["utils.js", "background.js"]
  },
  "browser_action": {
    "default_icon": {
      "16": "icons/forward-icon-16.png",
      "32": "icons/forward-icon-32.png"
    },
    "default_title": "Bulk Forward Selected Emails"
  },
  "message_display_action": {
    "default_icon": {
      "16": "icons/forward-icon-16.png",
      "32": "icons/forward-icon-32.png"
    },
    "default_title": "Quick Forward This Email"
  },
  "commands": {
    "bulk-forward-first": {
      "suggested_key": {
        "default": "Ctrl+Shift+F"
      },
      "description": "Bulk forward selected emails using first configuration"
    }
  },
  "icons": {
    "48": "icons/forward-icon-48.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "bulk-inline-forward@cjs.si",
      "strict_min_version": "91.0"
    }
  },
  "options_ui": {
    "page": "options.html"
  }
}
